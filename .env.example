PORT=8787
APP_BASE_URL=http://localhost:8787
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ADMIN_EMAIL=admin@assistq.local
ADMIN_PASSWORD=replace-this-password
WEBHOOK_SECRET=replace-this-webhook-secret

# Postgres connection string. Railway/Render inject this automatically once
# you attach a Postgres database to this service — you usually don't type
# it in by hand. For local development, run a local Postgres and set it here.
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# Google OAuth: create a Web application OAuth client in Google Cloud.
# Local redirect: http://localhost:8787/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional SMTP fallback for reports. Gmail OAuth is preferred.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REPORT_FROM=

# Google Apps Script production Web App URL used by the server-side chatbot proxy.
# Must end in /exec. Deploy Apps Script as: Execute as Me, access: Anyone.
APPS_SCRIPT_WEBHOOK_URL=

# Apps Script still needs ANTHROPIC_API_KEY and ASSISTQ_DASHBOARD_URL in its own Script Properties.

# WhatsApp Cloud API (Meta)
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_API_VERSION=v23.0

# Optional: turns the automation engine's follow-up queue from "queue it for
# a human to click send" into "actually send it automatically." Requires an
# APPROVED WhatsApp template with exactly one body variable (the follow-up
# message text is passed as that single variable) — create it in Meta
# Business Manager > WhatsApp Manager > Message Templates first, wait for
# approval, then set its exact name here. Without this, WA_PHONE_NUMBER_ID
# and WA_ACCESS_TOKEN alone still power manual template sends and the
# webhook — the automation engine just leaves follow-ups queued instead of
# sending them itself.
WA_FOLLOWUP_TEMPLATE_NAME=
WA_FOLLOWUP_TEMPLATE_LANG=en_US

# Razorpay — powers payment.html's checkout (Starter/Growth/Premium subscriptions).
# Key ID/Secret come from Razorpay Dashboard > Settings > API Keys.
# The three PLAN vars are Razorpay "Plan" IDs (plan_xxxxxxxx) — create one
# recurring monthly Plan per tier in Razorpay Dashboard > Subscriptions >
# Plans FIRST (Starter ₹999/mo, Growth ₹3,499/mo, Premium ₹6,999/mo), then
# paste each plan's ID here. Setup fees and the no-website landing-page
# charge are one-time "addons" added automatically at checkout — they
# don't need their own Plan.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional but strongly recommended: enables automatic detection of failed
# payments and cancellations, instead of a client's access silently staying
# active forever after they stop paying. Set this to whatever secret you
# choose when adding a webhook in Razorpay Dashboard > Settings > Webhooks,
# pointed at https://yourdomain/api/billing/webhook, subscribed to at least:
# subscription.charged, subscription.cancelled, subscription.halted,
# subscription.completed, subscription.activated, payment.failed
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_PREMIUM=
